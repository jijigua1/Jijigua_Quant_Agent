{
  "entrypoint": "compute(panels) -> DataFrame",
  "inputs": [
    {
      "basis": "host_choice",
      "dtype": "float64",
      "field": "close",
      "shape": "dates x securities",
      "symbol": "C",
      "unit": "currency/share"
    }
  ],
  "ir": {
    "args": [
      {
        "args": [
          {
            "args": [
              {
                "lag": {
                  "base": 0,
                  "time_index": null,
                  "var": "k"
                },
                "op": "field",
                "symbol": "C"
              },
              {
                "lag": {
                  "base": 5,
                  "time_index": null,
                  "var": "k"
                },
                "op": "field",
                "symbol": "C"
              }
            ],
            "op": "div"
          },
          {
            "op": "const",
            "value": 1.0
          }
        ],
        "op": "sub"
      }
    ],
    "end": 264,
    "op": "ts_mean",
    "start": 5,
    "var": "k"
  },
  "output": {
    "dtype": "float64",
    "missing": "NaN until every lag in the window is observed; NaN propagates; inf -> NaN",
    "name": "m",
